# Copy to .env. Every value is optional: with none set, the gateway runs in DEMO mode
# (local SolvaPay stand-in + mocked carbon curves) and needs no accounts at all.

# --- SolvaPay (switches the gateway to SANDBOX mode against the real SolvaPay API) ---
# Agent payments are in preview: SolvaPay must enable them on your merchant account first,
# otherwise every paid call is refused as `unavailable` (log shows feature_not_enabled).
# SOLVAPAY_SECRET_KEY=sk_sandbox_...
# SOLVAPAY_PROVIDER_REF=prov_...
# The agent key the built-in demo agent presents (a sandbox agent created in SolvaPay).
# SOLVAPAY_DEMO_AGENT_KEY=agk_sandbox_...

# --- Live carbon data (each one replaces the mock curves for its scenario) ---
# ELECTRICITY_MAPS_API_KEY=...
# WATTTIME_USERNAME=...
# WATTTIME_PASSWORD=...

# --- Server ---
# PORT=8000
# HOST=127.0.0.1
# DEMO_PACE_MS=350
